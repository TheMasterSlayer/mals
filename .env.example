# ============================================================
# MALS - Military Asset & Logistics Management System
# Environment Variables Template
# Copy to .env and fill in your values
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mals_db
DB_USERNAME=mals_user
DB_PASSWORD=mals_password

# --- JWT (CHANGE IN PRODUCTION - must be >= 32 characters) ---
JWT_SECRET=mals-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=86400000

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- Frontend (.env.local in /frontend) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api
